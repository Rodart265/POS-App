rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Roles live in each person's own document: users/{uid}
    //   { name, email, role: 'admin' | 'cashier', active: true }
    // No Cloud Functions or custom claims are needed.

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true;
    }

    function isAdmin() {
      return isActive() && myProfile().role == 'admin';
    }

    function isStaff() {
      return isActive() && myProfile().role in ['admin', 'cashier'];
    }

    match /users/{userId} {
      // Everyone can read their own document (the app needs it to find
      // their role, even if the account is disabled). Staff can read all.
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      // Admins can change anything. Cashiers can only change stock
      // (their sales deduct stock from the browser).
      allow update: if isAdmin()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stock', 'updatedAt']));
    }

    match /transactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.status in ['pending_payment', 'confirmed'];
      // Only an admin can void or edit freely. A cashier can only move
      // their own sale from pending_payment to confirmed.
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.cashierId == request.auth.uid
            && resource.data.status == 'pending_payment'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'confirmedAt', 'confirmedBy']));
      allow delete: if false;
    }

    // These logs are written from the app (there are no Cloud Functions),
    // add-only: entries can never be edited or deleted.
    match /stockLog/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
